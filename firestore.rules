rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all global (nenhum documento é acessível a menos que explicitamente permitido)
    match /{document=**} {
      allow read, write: if false;
    }

    // Endpoint de verificação de conectividade e liveness do Firestore
    match /test/{testId} {
      allow get: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'plan']) &&
        data.keys().hasOnly(['id', 'nome', 'email', 'plan', 'createdAt', 'updatedAt', 'avatarUrl']) &&
        data.id == userId &&
        data.plan in ['free', 'monthly', 'annual'] &&
        (!('nome' in data) || (data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 120)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000));
    }

    function isValidDiagnostic(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'createdAt', 'total', 'pilar1', 'pilar2', 'pilar3', 'pilar4']) &&
        data.keys().hasOnly(['id', 'userId', 'createdAt', 'total', 'pilar1', 'pilar2', 'pilar3', 'pilar4', 'nivel', 'pilarFraco', 'pilarForte', 'contexto', 'screenshotUrl', 'reportUrl']) &&
        data.userId == userId &&
        data.total is number && data.total >= 0 && data.total <= 100 &&
        data.pilar1 is number && data.pilar1 >= 0 && data.pilar1 <= 25 &&
        data.pilar2 is number && data.pilar2 >= 0 && data.pilar2 <= 25 &&
        data.pilar3 is number && data.pilar3 >= 0 && data.pilar3 <= 25 &&
        data.pilar4 is number && data.pilar4 >= 0 && data.pilar4 <= 25 &&
        (!('nivel' in data) || (data.nivel is string && data.nivel.size() <= 100)) &&
        (!('pilarFraco' in data) || (data.pilarFraco is string && data.pilarFraco.size() <= 100)) &&
        (!('pilarForte' in data) || (data.pilarForte is string && data.pilarForte.size() <= 100)) &&
        (!('contexto' in data) || data.contexto is map) &&
        (!('screenshotUrl' in data) || (data.screenshotUrl is string && data.screenshotUrl.size() <= 2000)) &&
        (!('reportUrl' in data) || (data.reportUrl is string && data.reportUrl.size() <= 2000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId) &&
                    request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /diagnostics/{diagnosticId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(diagnosticId) && isValidDiagnostic(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(diagnosticId) && isValidDiagnostic(request.resource.data, userId) &&
                      request.resource.data.id == resource.data.id &&
                      request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(diagnosticId);
      }
    }
  }
}
